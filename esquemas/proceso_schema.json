{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lavo/proceso_schema.json",
  "title": "Proceso industrial generico (nivel 3)",
  "description": "Referencia investigada. Nunca es una logica validada ni ejecutable: usa nombres funcionales, sin registros de LAVO.",
  "type": "object",
  "required": ["id", "nombre", "categoria", "tipo_conocimiento", "ejecutable", "descripcion", "sinonimos", "etapas",
               "entradas_funcionales", "salidas_funcionales", "temporizadores", "contadores", "repeticiones",
               "parametros_configurables", "arranque", "paro", "resultado_esperado", "fuentes"],
  "properties": {
    "id": {"type": "string"},
    "nombre": {"type": "string"},
    "categoria": {"type": "string"},
    "tipo_conocimiento": {"type": "string", "enum": ["proceso_industrial_generico"]},
    "ejecutable": {"type": "boolean", "enum": [false]},
    "descripcion": {"type": "string"},
    "sinonimos": {"type": "array", "items": {"type": "string"}},
    "etapas": {"type": "array", "items": {"type": "object", "required": ["orden", "nombre", "acciones", "transicion"],
               "properties": {"orden": {"type": "integer"}, "nombre": {"type": "string"},
                              "acciones": {"type": "array", "items": {"type": "string"}},
                              "transicion": {"type": "string"}}}},
    "entradas_funcionales": {"type": "array", "items": {"type": "object", "required": ["nombre", "descripcion"]}},
    "salidas_funcionales": {"type": "array", "items": {"type": "object", "required": ["nombre", "descripcion"]}},
    "temporizadores": {"type": "array"},
    "contadores": {"type": "array"},
    "repeticiones": {"type": "object"},
    "parametros_configurables": {"type": "array"},
    "arranque": {"type": "string"},
    "paro": {"type": "string"},
    "resultado_esperado": {"type": "string"},
    "requiere_componentes_tipicos": {"type": "array", "items": {"type": "string"}},
    "fuentes": {"type": "array", "items": {"type": "object", "required": ["titulo", "url"]}},
    "nota": {"type": "string"}
  }
}
